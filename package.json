{
  "name": "@excel.js/exceljs",
  "version": "0.13.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files.",
  "license": "MIT",
  "imports": {
    "#utils/*": "./lib/utils/*.js",
    "#doc/*": "./lib/doc/*.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/excel-js/exceljs.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "types": "./index.d.ts",
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "test": "npm run build && npm run test:unit && npm run test:integration && npm run test:end-to-end",
    "test:bun": "bun test tests",
    "test:unit": "mocha --require spec/config/setup spec/unit --recursive",
    "test:integration": "mocha --require spec/config/setup spec/integration --recursive",
    "test:end-to-end": "mocha --require spec/config/setup spec/end-to-end --recursive",
    "benchmark": "node --expose-gc benchmark",
    "benchmark:debug": "node --expose-gc --inspect-brk --trace-deopt benchmark",
    "build": "tsdown",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "font",
    "border",
    "fill",
    "number",
    "format",
    "number format",
    "alignment",
    "office",
    "spreadsheet",
    "workbook",
    "defined names",
    "data validations",
    "rich text",
    "in-cell format",
    "outlineLevel",
    "views",
    "frozen",
    "split",
    "pageSetup"
  ],
  "dependencies": {
    "@excel.js/archiver": "0.0.5",
    "@excel.js/jszip": "0.2.0",
    "@excel.js/unzipper": "0.2.0",
    "dayjs": "^1.8.34",
    "fast-csv": "^5.0.5",
    "saxes": "^6.0.0",
    "tmp": "^0.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.39",
    "chai": "4.5.0",
    "chai-datetime": "1.8.1",
    "chai-xml": "0.3.2",
    "dirty-chai": "2.0.1",
    "express": "4.22.1",
    "got": "9.6.0",
    "mocha": "10.8.2",
    "tsdown": "0.21.7",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./modelcontainer": "./dist/modelcontainer.mjs",
    "./workbook": "./dist/workbook.mjs",
    "./package.json": "./package.json"
  }
}
